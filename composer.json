{
  "name": "mmitekk/img_attr_module",
  "description": "Automatically adds missing intrinsic dimensions to Drupal image elements.",
  "type": "drupal-custom-module",
  "keywords": ["drupal", "image", "width", "height", "responsive-images"],
  "homepage": "https://github.com/Mmitekk/ImgDrupalAttritutes",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Mmitekk",
      "homepage": "https://github.com/Mmitekk",
      "role": "Maintainer"
    }
  ],
  "require": {
    "php": ">=8.1",
    "drupal/core": "^9.5 || ^10 || ^11",
    "ext-dom": "*"
  },
  "extra": {
    "drupal": {
      "packageName": "mmitekk/img_attr_module"
    },
    "installer-paths": {
      "web/modules/custom/{$name}": ["type:drupal-custom-module"]
    }
  },
  "support": {
    "issues": "https://github.com/Mmitekk/ImgDrupalAttritutes/issues",
    "source": "https://github.com/Mmitekk/ImgDrupalAttritutes"
  }
}
